<?xml version="1.0" encoding="utf-8" ?>
<connectionStrings>
	<!-- add name = "TranslatorAppDb" строка подключения к БД SQLite для приложения-переводчика -->
	<add name="TranslatorAppDb"
		 connectionString="Data Source=translator_app_db;Version=3;"
		 providerName="System.Data.SQLite"/>
</connectionStrings>
